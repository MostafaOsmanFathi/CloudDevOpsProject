# Copy this file to ".env" and adjust the values if you need to override
# the defaults that are already defined inside docker-compose.yml.
#
#   cp .env.example .env
#
# NOTE: ".env" must never be committed to git (it may contain real secrets).

# --- Database (MySQL) ---
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=ivolve
MYSQL_USER=ibrahim
MYSQL_PASSWORD=pass@123
MYSQL_PORT=3306

# --- Auth service ---
AUTH_SERVICE_PORT=5000

# --- Roadmap service ---
ROADMAP_SERVICE_PORT=8080

# --- Frontend ---
FRONTEND_PORT=3000
SESSION_SECRET=change-me-in-k8s
