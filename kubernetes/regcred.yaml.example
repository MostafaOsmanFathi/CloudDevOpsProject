# Template for the Docker Hub pull secret. Copy it to regcred.yaml, fill in the
# token, apply it, and leave regcred.yaml out of git (it is in .gitignore).
#
# The Deployments reference `imagePullSecrets: [{name: dockerhub}]`, so the
# secret must be named `dockerhub` and live in the `ivolve` namespace:
#
#   kubectl -n ivolve create secret docker-registry dockerhub \
#     --docker-server=https://index.docker.io/v1/ \
#     --docker-username=mostafaosmanfathi \
#     --docker-password='<DOCKERHUB_ACCESS_TOKEN>' \
#     --docker-email='<your email>'
#
# The token needs Read access to the private repositories
# mostafaosmanfathi/{frontend,auth-service,roadmap-service}. Create it at
# https://app.hub.docker.com -> Account settings -> Security -> Access tokens.
apiVersion: v1
kind: Secret
metadata:
  name: dockerhub
  namespace: ivolve
  labels:
    app.kubernetes.io/part-of: ivolve-devops
type: kubernetes.io/dockerconfigjson
stringData:
  .dockerconfigjson: |
    {
      "auths": {
        "https://index.docker.io/v1/": {
          "username": "mostafaosmanfathi",
          "password": "<DOCKERHUB_ACCESS_TOKEN>",
          "auth": "<base64 of username:token>"
        }
      }
    }
