# Azure credentials for the Terraform Azure project.
# Copy this file to azure-credentials.env, adjust it and source it BEFORE
# running terraform:
#
#   cp azure-credentials.env.example azure-credentials.env
#   # edit azure-credentials.env
#   source azure-credentials.env
#   cd terraform/azure && terraform plan
#
# The AzureRM provider reads ARM_* from the environment, so the values are
# never written to a .tf file or to terraform.tfvars. The copy in this
# repository is ignored by git.

# Subscription and tenant, filled in for this account.
# Get them with:
#   az account show --query id        -o tsv
#   az account show --query tenantId  -o tsv
export ARM_SUBSCRIPTION_ID="a46049d1-9063-4919-a44a-c61c2c07cd42"
export ARM_TENANT_ID="f2b34026-ae5e-4b9c-be0c-4c268dce6de9"

# Only needed when a service principal is used instead of the Azure CLI
# session. Leave these commented out while "az login" is used, because setting
# them to an empty string overrides the CLI session.
# export ARM_CLIENT_ID=""
# export ARM_CLIENT_SECRET=""
