# Backend configuration for the remote S3 state.
# Copy this file to backend.hcl and fill in the values printed by the bootstrap
# module (terraform/bootstrap -> terraform output backend_config).
#
#   cp backend.hcl.example backend.hcl
#   terraform init -backend-config=backend.hcl
#
bucket         = "ivolve-devops-tfstate-123456789012"
key            = "terraform.tfstate"
region         = "us-east-1"
encrypt        = true
dynamodb_table = "ivolve-devops-tfstate-locks"

# Optional: use the native S3 lock file instead of the DynamoDB table.
# Requires Terraform 1.10 or newer.
# use_lockfile = true
